#: ../../../spack.modules.rst:41
msgid "spack.modules.tcl module"
msgstr ""

#: ../../../_spack_root/lib/spack/spack/modules/tcl.py:docstring of
#: spack.modules.tcl:1
msgid "This module implements the classes necessary to generate Tcl modules."
msgstr ""

#: ../../../_spack_root/lib/spack/spack/modules/tcl.py:docstring of
#: spack.modules.tcl.TclConfiguration:1
msgid "Configuration class for tcl module files."
msgstr ""

#: ../../../_spack_root/lib/spack/spack/modules/tcl.py:docstring of
#: spack.modules.tcl.TclConfiguration.aggregated_variants:1
msgid ""
"Returns a consolidated dictionary of defined variants across installations, "
"with their type and sorted values. A variant that only some installations "
"define also takes the neutral value standing for it on the others. This "
"dictionary is sorted by its keys, which are variant names, followed by the "
"\"hash\" variant. Returns an empty dictionary if variant mode is disabled."
msgstr ""

#: ../../../_spack_root/lib/spack/spack/modules/tcl.py:docstring of
#: spack.modules.tcl.TclConfiguration.configurations_in_file:1
msgid ""
"Returns the configuration of each installed spec of same name@version that "
"maps to the same module filename, in the order the module file lists them."
msgstr ""

#: ../../../_spack_root/lib/spack/spack/modules/tcl.py:docstring of
#: spack.modules.tcl.TclConfiguration.folds_installations:1
msgid ""
"Whether several installations may share this module file, which then folds "
"them. This is the case when variants are enabled and the module file name "
"does not include the hash, as different installations of the same package "
"version then map to the same file name."
msgstr ""

#: ../../../_spack_root/lib/spack/spack/modules/tcl.py:docstring of
#: spack.modules.tcl.TclConfiguration.hash:1
msgid ""
"Hash appended to the module file name, or None when variants are defined, as "
"the hash variant then replaces the hash in module names."
msgstr ""

#: ../../../_spack_root/lib/spack/spack/modules/tcl.py:docstring of
#: spack.modules.tcl.TclConfiguration.variant_values:1
msgid ""
"Returns the values of the variants of this installation, in the order of the "
"aggregated variants. A variant this installation does not define takes the "
"neutral value that the aggregated variants give to it."
msgstr ""

#: ../../../_spack_root/lib/spack/spack/modules/tcl.py:docstring of
#: spack.modules.tcl.TclConfiguration.variants:1
msgid ""
"Returns a dictionary of defined variants keyed by variant name. Any multi-"
"valued variant is transformed into a single-valued one, joining values. The "
"dictionary is sorted by its keys, followed by the \"hash\" variant, which "
"identifies the installation. Returns an empty dictionary if variant mode is "
"disabled."
msgstr ""

#: ../../../_spack_root/lib/spack/spack/modules/tcl.py:docstring of
#: spack.modules.tcl.TclConfiguration.variants_enabled:1
#: spack.modules.tcl.TclModuleContext.variants_enabled:1
msgid "Whether variants are defined in module files."
msgstr ""

#: ../../../_spack_root/lib/spack/spack/modules/tcl.py:docstring of
#: spack.modules.tcl.TclConfiguration.variants_mode:1
msgid "Returns module file variants definition mode."
msgstr ""

#: ../../../_spack_root/lib/spack/spack/modules/tcl.py:docstring of
#: spack.modules.tcl.TclFileLayout:1
msgid "Layout of tcl module files, whose names may be followed by variants."
msgstr ""

#: ../../../_spack_root/lib/spack/spack/modules/tcl.py:docstring of
#: spack.modules.tcl.TclFileLayout.unique_use_name:1
msgid ""
"Returns the name that selects this installation from a dependent module "
"file. The \"hash\" variant is the only one stated when variants are defined, "
"so the name stays valid whatever variants the module file defines later on."
msgstr ""

#: ../../../_spack_root/lib/spack/spack/modules/tcl.py:docstring of
#: spack.modules.tcl.TclFileLayout.use_name:1
msgid ""
"Returns the name used to load the module, followed by its variants if "
"defined."
msgstr ""

#: ../../../_spack_root/lib/spack/spack/modules/tcl.py:docstring of
#: spack.modules.tcl.TclModuleContext:1
msgid ""
"Template context of tcl module files, which may hold several installations."
msgstr ""

#: ../../../_spack_root/lib/spack/spack/modules/tcl.py:docstring of
#: spack.modules.tcl.TclModuleContext.aggregated_variants:1
msgid ""
"Returns the variants defined across the installations held by the module "
"file."
msgstr ""

#: ../../../_spack_root/lib/spack/spack/modules/tcl.py:docstring of
#: spack.modules.tcl.TclModuleContext.any_installation_has_autoload:1
msgid ""
"Whether an installation held by the module file has a dependency to auto "
"load."
msgstr ""

#: ../../../_spack_root/lib/spack/spack/modules/tcl.py:docstring of
#: spack.modules.tcl.TclModuleContext.hash:1
msgid "Returns hash of this installation"
msgstr ""

#: ../../../_spack_root/lib/spack/spack/modules/tcl.py:docstring of
#: spack.modules.tcl.TclModuleContext.installations:1
msgid ""
"Returns the context of each installation held by the module file, in the "
"order the module file selects them."
msgstr ""

#: ../../../_spack_root/lib/spack/spack/modules/tcl.py:docstring of
#: spack.modules.tcl.TclModuleContext.variant_values:1
msgid "Returns the values of the variants of this installation."
msgstr ""

#: ../../../_spack_root/lib/spack/spack/modules/tcl.py:docstring of
#: spack.modules.tcl.module_variant_value:1
msgid ""
"Returns a variant value in the form the module command reads back once "
"loaded: ``++`` is spelled ``xx`` as in ``cxx``, any other character than "
"letters, digits, ``_``, ``-``, ``.`` and ``/`` becomes ``_``, and a value "
"the module command reads as a boolean gets a trailing ``_``."
msgstr ""
