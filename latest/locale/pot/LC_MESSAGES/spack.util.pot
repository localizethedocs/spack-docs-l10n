#: ../../../_spack_root/lib/spack/spack/util/compression.py:docstring of
#: spack.util.compression.BZipFileType.peek:1
#: spack.util.compression.CompressedFileTypeInterface.peek:1
#: spack.util.compression.GZipFileType.peek:1
#: spack.util.compression.LzmaFileType.peek:1
msgid ""
"This method returns the first num_bytes of a decompressed stream. Returns "
"None if no builtin support for decompression."
msgstr ""

#: ../../../_spack_root/lib/spack/spack/util/compression.py:docstring of
#: spack.util.compression.CompressedFileTypeInterface:1
msgid "Interface class for FileTypes that include compression information"
msgstr ""

#: ../../../_spack_root/lib/spack/spack/util/compression.py:docstring of
#: spack.util.compression.FileTypeInterface:1
msgid ""
"Base interface class for describing and querying file type information. "
"FileType describes information about a single file type such as typical "
"extension and byte header properties, and provides an interface to check a "
"given file against said type based on magic number."
msgstr ""

#: ../../../_spack_root/lib/spack/spack/util/compression.py:docstring of
#: spack.util.compression.FileTypeInterface:5
msgid ""
"This class should be subclassed each time a new type is to be described."
msgstr ""

#: ../../../_spack_root/lib/spack/spack/util/compression.py:docstring of
#: spack.util.compression.FileTypeInterface:7
msgid ""
"Subclasses should each describe a different type of file. In order to do so, "
"they must define the extension string, magic number, and header offset (if "
"non zero). If a class has multiple magic numbers, it will need to override "
"the method describing that file type's magic numbers and the method that "
"checks a types magic numbers against a given file's."
msgstr ""

#: ../../../_spack_root/lib/spack/spack/util/compression.py:docstring of
#: spack.util.compression.FileTypeInterface.header_size:1
msgid "Return size of largest magic number associated with file type"
msgstr ""

#: ../../../_spack_root/lib/spack/spack/util/compression.py:docstring of
#: spack.util.compression.FileTypeInterface.magic_numbers:1
msgid "Return a list of all potential magic numbers for a filetype"
msgstr ""

#: ../../../_spack_root/lib/spack/spack/util/compression.py:docstring of
#: spack.util.compression.FileTypeInterface.matches_magic:1
msgid ""
"Returns true if the stream matches the current file type by any of its magic "
"numbers. Resets stream to original position."
msgstr ""

#: ../../../_spack_root/lib/spack/spack/util/compression.py:docstring of
#: spack.util.compression.FileTypeInterface.matches_magic:4
msgid "file byte stream"
msgstr ""

#: ../../../_spack_root/lib/spack/spack/util/compression.py:docstring of
#: spack.util.compression.MAX_BYTES_ARCHIVE_HEADER:1
msgid ""
"Maximum number of bytes to read from a file to determine any archive type. "
"Tar is the largest."
msgstr ""

#: ../../../_spack_root/lib/spack/spack/util/compression.py:docstring of
#: spack.util.compression.SUPPORTED_FILETYPES:1
msgid ""
"Collection of supported archive and compression file type identifier classes."
msgstr ""

#: ../../../_spack_root/lib/spack/spack/util/compression.py:docstring of
#: spack.util.compression.decompressor_for:1
msgid ""
"Returns appropriate decompression/extraction algorithm function pointer for "
"provided extension. If extension is none, it is computed from the ``path`` "
"and the decompression function is derived from that information."
msgstr ""

#: ../../../_spack_root/lib/spack/spack/util/compression.py:docstring of
#: spack.util.compression.decompressor_for_nix:1
msgid ""
"Returns a function pointer to appropriate decompression algorithm based on "
"extension type and unix specific considerations i.e. a reasonable "
"expectation system utils like gzip, bzip2, and xz are available"
msgstr ""

#: ../../../_spack_root/lib/spack/spack/util/compression.py:docstring of
#: spack.util.compression.decompressor_for_nix:5
msgid "path of the archive file requiring decompression"
msgstr ""

#: ../../../_spack_root/lib/spack/spack/util/compression.py:docstring of
#: spack.util.compression.decompressor_for_win:1
msgid ""
"Returns a function pointer to appropriate decompression algorithm based on "
"extension type and Windows specific considerations"
msgstr ""

#: ../../../_spack_root/lib/spack/spack/util/compression.py:docstring of
#: spack.util.compression.decompressor_for_win:4
msgid ""
"Windows natively vendors *only* tar, no other archive/compression utilities "
"So we must rely exclusively on Python module support for all compression "
"operations, tar for tarballs and zip files, and 7zip for Z compressed "
"archives and files as Python does not provide support for the UNIX compress "
"algorithm"
msgstr ""

#: ../../../_spack_root/lib/spack/spack/util/compression.py:docstring of
#: spack.util.compression.extension_from_magic_numbers:1
msgid ""
"Return typical extension without leading ``.`` of a compressed file or "
"archive at the given path, based on its magic numbers, similar to the "
"``file`` utility. Notice that the extension returned from this function may "
"not coincide with the file's given extension."
msgstr ""

#: ../../../_spack_root/lib/spack/spack/util/compression.py:docstring of
#: spack.util.compression.extension_from_magic_numbers:5
msgid "file to determine extension of"
msgstr ""

#: ../../../_spack_root/lib/spack/spack/util/compression.py:docstring of
#: spack.util.compression.extension_from_magic_numbers:6
msgid ""
"If True, method will peek into decompressed file to check for archive file "
"types. If False, the method will return only the top-level extension (for "
"example ``gz`` and not ``tar.gz``)."
msgstr ""

#: ../../../_spack_root/lib/spack/spack/util/compression.py:docstring of
#: spack.util.compression.extension_from_magic_numbers:10
msgid ""
"Spack recognized archive file extension as determined by file's magic number "
"and file name. If file is not on system or is of a type not recognized by "
"Spack as an archive or compression type, None is returned. If the file is "
"classified as a compressed tarball, the extension is abbreviated (for "
"instance ``tgz`` not ``tar.gz``) if that matches the file's given extension."
msgstr ""

#: ../../../_spack_root/lib/spack/spack/util/compression.py:docstring of
#: spack.util.compression.extension_from_magic_numbers_by_stream:1
msgid ""
"Returns the typical extension for the opened file, without leading ``.``, "
"based on its magic numbers."
msgstr ""

#: ../../../_spack_root/lib/spack/spack/util/compression.py:docstring of
#: spack.util.compression.extension_from_magic_numbers_by_stream:4
msgid ""
"If the stream does not represent file type recognized by Spack (see :py:data:"
"`SUPPORTED_FILETYPES`), the method will return None"
msgstr ""

#: ../../../_spack_root/lib/spack/spack/util/compression.py:docstring of
#: spack.util.compression.extension_from_magic_numbers_by_stream:7
msgid "stream representing a file on system"
msgstr ""

#: ../../../_spack_root/lib/spack/spack/util/compression.py:docstring of
#: spack.util.compression.extension_from_magic_numbers_by_stream:8
msgid ""
"if True, compressed files are checked for archive types beneath compression. "
"For example tar.gz if True versus only gz if False."
msgstr ""

#: ../../../spack.util.rst:50
msgid "spack.util.cpus module"
msgstr ""

#: ../../../_spack_root/lib/spack/spack/util/cpus.py:docstring of
#: spack.util.cpus.cpus_available:1
msgid ""
"Returns the number of CPUs available for the current process, or the number "
"of physical CPUs when that information cannot be retrieved. The number of "
"available CPUs might differ from the number of physical CPUs when using "
"spack through Slurm or container runtimes."
