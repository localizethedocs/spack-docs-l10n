#: ../../../_spack_root/lib/spack/spack/util/archive.py:docstring of
#: spack.util.archive.reproducible_tarfile_from_prefix:13
msgid ""
"function that converts a path string to a tarfile entry name, which should "
"be in posix format. Not only is it necessary to transform paths in certain "
"cases, such as windows path to posix format, but it can also be used to "
"prepend a directory to each entry even if it does not exist on the "
"filesystem. The default implementation drops the leading slash on posix and "
"the drive letter on windows for absolute paths, and formats as a posix."
msgstr ""

