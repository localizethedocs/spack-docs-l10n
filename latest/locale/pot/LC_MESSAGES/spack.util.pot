#: ../../../_spack_root/lib/spack/spack/util/filesystem.py:docstring of
#: spack.util.filesystem.filter_file:22
msgid ""
"Marker used to stop scanning the file further. If a text line matches this "
"marker filtering is stopped and the rest of the file is copied verbatim. "
"Default is to filter until the end of the file."
msgstr ""

