#: ../../../gpu_configuration.rst:-1
msgid ""
"A guide to configuring Spack to use external GPU support, including ROCm and "
"CUDA installations, as well as the OpenGL API."
msgstr ""

#: ../../../gpu_configuration.rst:11
msgid "Using External GPU Support"
msgstr ""

#: ../../../gpu_configuration.rst:13
msgid ""
"Many packages come with a ``+cuda`` or ``+rocm`` variant. With no added "
"configuration, Spack will download and install the needed components. It may "
"be preferable to use existing system support: the following sections help "
"with using a system installation of GPU libraries."
msgstr ""

#: ../../../gpu_configuration.rst:18
msgid "Using an External ROCm Installation"
msgstr ""

#: ../../../gpu_configuration.rst:20
msgid ""
"Spack breaks down ROCm into many separate component packages. The following "
"is an example ``packages.yaml`` that organizes a consistent set of ROCm "
"components for use by dependent packages:"
msgstr ""

#: ../../../gpu_configuration.rst:23
msgid ""
"packages:\n"
"  all:\n"
"    variants: amdgpu_target=gfx90a\n"
"  hip:\n"
"    buildable: false\n"
"    externals:\n"
"    - spec: \"hip@10.1 %gcc@13.3.0\" # define default GCC libstc++ that "
"should be used\n"
"      prefix: /opt/rocm/core-10.1\n"
"  amdsmi:\n"
"    buildable: false\n"
"    externals:\n"
"    - spec: amdsmi@10.1\n"
"      prefix: /opt/rocm/core-10.1\n"
"  comgr:\n"
"    buildable: false\n"
"    externals:\n"
"    - spec: comgr@10.1\n"
"      prefix: /opt/rocm/core-10.1\n"
"  hipblas:\n"
"    buildable: false\n"
"    externals:\n"
"    - spec: hipblas@10.1\n"
"      prefix: /opt/rocm/core-10.1\n"
"  hipcub:\n"
"    buildable: false\n"
"    externals:\n"
"    - spec: hipcub@10.1\n"
"      prefix: /opt/rocm/core-10.1\n"
"  hipfft:\n"
"    buildable: false\n"
"    externals:\n"
"    - spec: hipfft@10.1\n"
"      prefix: /opt/rocm/core-10.1\n"
"  hiprand:\n"
"    buildable: false\n"
"    externals:\n"
"    - spec: hiprand@10.1\n"
"      prefix: /opt/rocm/core-10.1\n"
"  hipsparse:\n"
"    buildable: false\n"
"    externals:\n"
"    - spec: hipsparse@10.1\n"
"      prefix: /opt/rocm/core-10.1\n"
"  miopen-hip:\n"
"    buildable: false\n"
"    externals:\n"
"    - spec: miopen-hip@10.1\n"
"      prefix: /opt/rocm/core-10.1\n"
"  rccl:\n"
"    buildable: false\n"
"    externals:\n"
"    - spec: rccl@10.1\n"
